<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Coreboot4All — Device Catalog</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; max-width: 1000px; margin: 2rem auto; padding: 0 1rem; color: #1b1f23; line-height: 1.5; }
    header { border-bottom: 2px solid #d0d7de; padding-bottom: 1rem; margin-bottom: 1.5rem; }
    nav a { margin-right: 1rem; color: #0969da; text-decoration: none; font-weight: 600; }
    .counts { display: flex; gap: 1rem; margin: 1rem 0; flex-wrap: wrap; }
    .card { border: 1px solid #d0d7de; border-radius: 6px; padding: 0.75rem 1rem; background: #f6f8fa; }
    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { border: 1px solid #d0d7de; padding: 0.5rem 0.75rem; text-align: left; }
    th { background: #f6f8fa; }
    .tier { display: inline-block; padding: 0.15rem 0.5rem; border-radius: 4px; font-weight: 700; color: #fff; }
    .tier-A { background: #1a7f37; }
    .tier-B { background: #0969da; }
    .tier-C { background: #9a6700; }
    .tier-D { background: #cf222e; }
    footer { margin-top: 2rem; font-size: 0.875rem; color: #57606a; border-top: 1px solid #d0d7de; padding-top: 1rem; }
  </style>
</head>
<body>
  <header>
    <h1>Coreboot4All Device Catalog</h1>
    <p>Repeatable coreboot compatibility, portability scores, blockers, and build manifests.</p>
    <nav>
      <a href="index.html">All Devices</a>
      <a href="tier-d.html">Tier D (Blocked Devices)</a>
      <a href="catalog.json">catalog.json</a>
    </nav>
  </header>

  <section class="counts">
    <div class="card"><strong>Tier A (Supported):</strong> {{ counts["A"] }}</div>
    <div class="card"><strong>Tier B (Near-supported):</strong> {{ counts["B"] }}</div>
    <div class="card"><strong>Tier C (Research):</strong> {{ counts["C"] }}</div>
    <div class="card"><strong>Tier D (Blocked):</strong> {{ counts["D"] }}</div>
  </section>

  <table>
    <thead>
      <tr>
        <th>Device</th>
        <th>Year</th>
        <th>Platform</th>
        <th>Tier</th>
        <th>Score</th>
        <th>Build Verified</th>
      </tr>
    </thead>
    <tbody>
      {% for d in devices %}
      <tr>
        <td><a href="devices/{{ d.id }}.html">{{ d.vendor }} {{ d.model }}</a></td>
        <td>{{ d.year }}</td>
        <td>{{ d.platform.cpu_vendor }} / {{ d.platform.chipset }}</td>
        <td><span class="tier tier-{{ d.status.tier }}">{{ d.status.tier }}</span></td>
        <td>{{ d.status.score }}/100</td>
        <td>{{ "Yes" if d.status.build_verified else "No" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  <footer>
    Generated offline by Coreboot4All at {{ generated_utc }}. Zero JavaScript. Zero external network requests.
  </footer>
</body>
</html>
